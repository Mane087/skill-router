{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["tests/**/*", "evals/**/*", "**/*.test.ts", "**/*.spec.ts"]
}
